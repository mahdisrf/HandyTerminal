<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandyTerminal.MainWindow"
        Title="HandyTerminal"
        Width="980"
        Height="760">

    <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Name="AddTabButton" Content="Add tab" Width="100" />
            <Button Name="AddCommandButton" Content="Add command" Width="120" />
            <Button Name="DeleteTabButton" Content="Delete tab" Width="110" />
            <Button Name="ImportButton" Content="Import .txt" Width="110" />
            <Button Name="ExportButton" Content="Export .txt" Width="110" />
            <TextBox Name="TabTitleBox" PlaceholderText="Tab title" Width="220" />
            <Button Name="SaveTabTitleButton" Content="Save title" Width="110" />
            <TextBlock Text="HandyTerminal" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Name="TabBar" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Name="CommandList" Spacing="8" />
        </ScrollViewer>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,260">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <TextBox Name="CommandInput" PlaceholderText="Run a shell command" MinWidth="320" />
                <TextBox Name="SudoPasswordBox" PlaceholderText="Sudo password (optional)" Width="200" PasswordChar="*" />
                <Button Name="RunInputButton" Content="Run" Width="90" />
                <Button Name="StopButton" Content="Stop" Width="90" />
                <Button Name="ClearButton" Content="Clear" Width="90" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,6"
                       Text="Live terminal output"
                       FontWeight="SemiBold" />

            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox Name="TerminalOutput"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="240"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             Margin="6" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>